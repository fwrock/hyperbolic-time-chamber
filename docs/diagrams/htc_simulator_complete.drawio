<mxfile host="app.diagrams.net" modified="2026-03-06T00:00:00.000Z" agent="GPT-5.3-Codex" version="24.7.17" type="device">
  <diagram id="overview" name="01 - Visao Geral">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="t1" value="Hyperbolic Time Chamber (HTC) - Arquitetura Completa&#xa;Simulador distribuido event-driven (Scala + Apache Pekko)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="560" y="20" width="1080" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="c1" value="Entradas e Configuracao&#xa;- simulation config / actorsDataSources&#xa;- JSON de cenario (nodos, links, veiculos, pessoas)&#xa;- dependencies por ator&#xa;- application.conf" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="340" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="c2" value="Orquestracao Core&#xa;SimulationManager&#xa;LoadDataManager&#xa;ReportManager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="170" width="330" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="c3" value="Gestao de Tempo&#xa;GlobalTimeManager&#xa;pool LocalDiscreteEventTimeManager&#xa;(opcional LocalTimeSteppedTimeManager)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="860" y="170" width="390" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="c4" value="Camada de Atores de Simulacao&#xa;BaseActor / SimulationBaseActor&#xa;Movable + atores hibridos (Car, Bus, Bicycle, Motorcycle, Person, Link, Node, TrafficSignal, BusStop/Station, Subway, RailLink, SubwayStation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1310" y="150" width="840" height="240" as="geometry"/>
        </mxCell>

        <mxCell id="c5" value="Engine do Modelo Simulado&#xa;- Meso: velocidade agregada por densidade&#xa;- Micro: sub-ticks por link, posicao/velocidade por veiculo&#xa;- Troca de modo por link (SimulationMode: MESO/MICRO)&#xa;- Mensageria por eventos (EnterLink/LeaveLink/MicroUpdate etc.)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="460" y="450" width="790" height="230" as="geometry"/>
        </mxCell>

        <mxCell id="c6" value="Saidas / Observabilidade&#xa;- ReportEvent (CSV e outras estrategias)&#xa;- eventos de trafego e metrica de viagem (SUMO-like)&#xa;- custos dinamicos de link (cache distribuido)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1330" y="470" width="620" height="190" as="geometry"/>
        </mxCell>

        <mxCell id="c7" value="Integracoes Externas&#xa;- Cluster Sharding / Router Pool&#xa;- Cache de pesos dinamicos (DynamicWeightCache)&#xa;- Pipelines de validacao com SUMO (scripts)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="340" height="190" as="geometry"/>
        </mxCell>

        <mxCell id="e1" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="endArrow=block;html=1;dashed=1;" edge="1" parent="1" source="c7" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="startup" name="02 - Startup e Orquestracao">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="s0" value="Fluxo de Inicializacao da Simulacao" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="690" y="20" width="800" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="s1" value="1) SimulationManager.onStart&#xa;envia PrepareSimulationEvent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="120" y="130" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="s2" value="2) Carrega configuracao&#xa;(loadSimulationConfig)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="460" y="130" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="s3" value="3) Cria GlobalTimeManager&#xa;(singleton)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="800" y="130" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="s4" value="4) Cria ReportManager&#xa;(singleton)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1140" y="130" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="s5" value="5) Global cria pool LocalTimeManager&#xa;e registra TimeManagerRegisterEvent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1480" y="130" width="380" height="90" as="geometry"/></mxCell>

        <mxCell id="s6" value="6) ReportManager cria reporters&#xa;e envia RegisterReportersEvent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1480" y="270" width="380" height="90" as="geometry"/></mxCell>
        <mxCell id="s7" value="7) Quando poolTimeManager + reporters prontos:&#xa;SimulationManager cria LoadDataManager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1140" y="270" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="s8" value="8) LoadDataEvent -> loaders + creators&#xa;carregam atores por data source/classType" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="800" y="270" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="s9" value="9) FinishLoadDataEvent (all loaded)&#xa;retorna para SimulationManager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="460" y="270" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="s10" value="10) StartSimulationTimeEvent&#xa;enviado ao GlobalTimeManager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="270" width="300" height="90" as="geometry"/></mxCell>

        <mxCell id="s11" value="StopSimulationEvent propaga para&#xa;LoadManager / ReportManager / GlobalTimeManager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="660" y="440" width="720" height="90" as="geometry"/></mxCell>

        <mxCell id="se1" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se2" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se3" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se4" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se5" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se6" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se7" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se8" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="s8" target="s9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se9" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="s9" target="s10"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
