  </diagram>

  <diagram id="time" name="03 - Gestao de Tempo">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="tt" value="Coordenacao Temporal: Global + Locais" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="20" width="760" height="60" as="geometry"/></mxCell>

        <mxCell id="t1" value="GlobalTimeManager&#xa;- recebe StartSimulationTimeEvent&#xa;- broadcast UpdateGlobalTimeEvent(tick)&#xa;- agrega LocalTimeReportEvent de todos os locais&#xa;- calcula proximo tick global" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="120" width="620" height="180" as="geometry"/></mxCell>

        <mxCell id="t2" value="LocalTimeManagerBase (por routee)&#xa;- registra atores (RegisterActorEvent)&#xa;- agenda tick/atores (ScheduleEvent)&#xa;- dispara SpontaneousEvent para atores do tick&#xa;- recebe FinishEvent e reporta progresso ao global" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="300" y="370" width="720" height="220" as="geometry"/></mxCell>

        <mxCell id="t3" value="LocalDiscreteEventTimeManager&#xa;processTick(t):&#xa;1) dispara atores agendados em t&#xa;2) remove t da fila local&#xa;3) quando runningEvents vazio, reporta ao global" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1080" y="370" width="470" height="220" as="geometry"/></mxCell>

        <mxCell id="t4" value="Atores de simulacao (SimulationBaseActor)&#xa;- recebem SpontaneousEvent(tick)&#xa;- executam actSpontaneous/actInteractWith&#xa;- chamam onFinishSpontaneous(scheduleTick?)&#xa;- geram FinishEvent + opcional ScheduleEvent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="670" width="620" height="190" as="geometry"/></mxCell>

        <mxCell id="t5" value="Suporte Micro (MicroAwareTimeManager)&#xa;tick global pode disparar micro-links antes dos demais atores,&#xa;permitindo sub-ticks internos no modo MICRO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="300" y="670" width="420" height="190" as="geometry"/></mxCell>

        <mxCell id="te1" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="t1" target="t2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="te2" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="t1" target="t3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="te3" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="t2" target="t4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="te4" style="endArrow=block;html=1;dashed=1;" edge="1" parent="1" source="t5" target="t4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="te5" style="endArrow=block;html=1;dashed=1;" edge="1" parent="1" source="t4" target="t2"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="actor-lifecycle" name="04 - Ciclo de Vida do Ator">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="a0" value="Ciclo de Vida: BaseActor / SimulationBaseActor / Movable / PrivateVehicle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="20" width="1140" height="60" as="geometry"/></mxCell>

        <mxCell id="a1" value="preStart&#xa;onStart()&#xa;se properties.data existe: carrega state + startTick" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="100" y="140" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="a2" value="onInitialize(InitializeEvent)&#xa;entityId/state/dependencies/reporters/timeManagers&#xa;envia InitializeEntityAckEvent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="440" y="140" width="350" height="110" as="geometry"/></mxCell>
        <mxCell id="a3" value="registerOnTimeManager&#xa;RegisterActorEvent(startTick, Identify)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="830" y="140" width="320" height="110" as="geometry"/></mxCell>
        <mxCell id="a4" value="Loop de execucao&#xa;SpontaneousEvent -> actSpontaneous&#xa;ActorInteractionEvent -> actInteractWith&#xa;Lamport clock atualizado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1190" y="140" width="360" height="110" as="geometry"/></mxCell>
        <mxCell id="a5" value="onFinishSpontaneous(scheduleTick?)&#xa;- envia FinishEvent ao TimeManager atual&#xa;- se scheduleTick: envia ScheduleEvent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1590" y="140" width="420" height="110" as="geometry"/></mxCell>

        <mxCell id="a6" value="Movable: maquina de estados base&#xa;Start -> requestRoute -> Ready -> enterLink -> Waiting -> ... -> Finished" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="100" y="340" width="620" height="130" as="geometry"/></mxCell>
        <mxCell id="a7" value="PrivateVehicle (Car/Bicycle/Motorcycle)&#xa;Parked (passivo) -> StartTripData -> Start&#xa;trip ativa -> TripCompletedData para Person -> Parked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="760" y="340" width="640" height="130" as="geometry"/></mxCell>
        <mxCell id="a8" value="Destruicao&#xa;DestructEvent -> onDestruct -> context.stop(self)&#xa;em stop global: time managers forcam destrucao de atores ativos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1440" y="340" width="570" height="130" as="geometry"/></mxCell>

        <mxCell id="ae1" style="endArrow=block;html=1;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae2" style="endArrow=block;html=1;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae3" style="endArrow=block;html=1;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae4" style="endArrow=block;html=1;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae5" style="endArrow=block;html=1;dashed=1;" edge="1" parent="1" source="a5" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="ae6" style="endArrow=block;html=1;" edge="1" parent="1" source="a6" target="a7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae7" style="endArrow=block;html=1;" edge="1" parent="1" source="a7" target="a8"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="hybrid-flow" name="05 - Fluxo Hibrido MESO MICRO">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="h0" value="Fluxo Hibrido por Link (Car/Bus/Bicycle/Motorcycle)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="20" width="1040" height="60" as="geometry"/></mxCell>

        <mxCell id="h1" value="Movable envia EnterLinkData para Link" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="130" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="h2" value="Link verifica simulationMode" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="500" y="125" width="240" height="100" as="geometry"/></mxCell>

        <mxCell id="h3" value="MESO branch&#xa;register + LinkInfoData&#xa;velocidade agregada (density)&#xa;car/veiculo agenda leave" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="390" height="120" as="geometry"/></mxCell>

        <mxCell id="h4" value="MICRO branch&#xa;assign lane + MicroEnterLinkData&#xa;inicializa microState no veiculo&#xa;ativa schedule de micro tick" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="820" y="260" width="390" height="130" as="geometry"/></mxCell>

        <mxCell id="h5" value="Por tick global: Link executa N sub-ticks&#xa;- processa cada lane (leader/gap/safe vel)&#xa;- atualiza VehicleInLane&#xa;- envia MicroUpdateData" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1280" y="240" width="560" height="150" as="geometry"/></mxCell>

        <mxCell id="h6" value="Veiculo no MICRO&#xa;atualiza microState e verifica fim de link&#xa;quando position &gt;= length: leave" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1280" y="430" width="560" height="120" as="geometry"/></mxCell>

        <mxCell id="h7" value="Link envia MicroLeaveLinkData&#xa;remove de lane/registered&#xa;veiculo desativa microMode e volta ao fluxo Movable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="820" y="430" width="390" height="120" as="geometry"/></mxCell>

        <mxCell id="h8" value="Node + TrafficSignal&#xa;veiculo consulta RequestSignalStateData&#xa;Node responde SignalStateData (Green/Red + nextTick)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="300" width="620" height="120" as="geometry"/></mxCell>

        <mxCell id="h9" value="Link tambem publica custo dinamico para roteamento&#xa;(DynamicLinkCost -> cache distribuido)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="120" y="470" width="620" height="80" as="geometry"/></mxCell>

        <mxCell id="he1" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="h1" target="h2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he2" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="h2" target="h3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he3" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="h2" target="h4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he4" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="h4" target="h5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he5" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="h5" target="h6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he6" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="h6" target="h7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he7" style="endArrow=block;html=1;dashed=1;" edge="1" parent="1" source="h8" target="h3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he8" style="endArrow=block;html=1;dashed=1;" edge="1" parent="1" source="h9" target="h3"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="transport" name="06 - Pessoa e Rede de Transporte">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="p0" value="Modelo Simulado: Pessoa-Centrico + Transporte Coletivo + Rede Ferroviaria" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="20" width="1240" height="60" as="geometry"/></mxCell>

        <mxCell id="p1" value="Person&#xa;- agenda de atividades&#xa;- mode choice por ArrivalLogistics&#xa;- ativa private vehicle via StartTripData&#xa;- recebe TripCompletedData" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="130" width="430" height="170" as="geometry"/></mxCell>

        <mxCell id="p2" value="Private Vehicles&#xa;Car / Bicycle / Motorcycle&#xa;estado Parked -&gt; Start -&gt; Moving -&gt; Finished/Parked&#xa;aplicam DriverAttributes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="570" y="130" width="480" height="170" as="geometry"/></mxCell>

        <mxCell id="p3" value="Infra viaria&#xa;Node + Link + TrafficSignal&#xa;registro de bus stops/subway stations&#xa;controle de sinal por fase" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1110" y="130" width="430" height="170" as="geometry"/></mxCell>

        <mxCell id="p4" value="Onibus (Bus) + BusStop + BusStation&#xa;- BusStation calcula rota via mapa&#xa;- cria buses periodicamente&#xa;- BusStop registra passageiros e atende pedidos de embarque" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="90" y="360" width="670" height="170" as="geometry"/></mxCell>

        <mxCell id="p5" value="Subway + SubwayStation + RailLink&#xa;- SubwayStation cria trens por linha e horario&#xa;- Subway usa rota predefinida (rail links)&#xa;- RailLink valida tipo de veiculo (safety)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="810" y="360" width="730" height="170" as="geometry"/></mxCell>

        <mxCell id="p6" value="Saidas de simulacao&#xa;- eventos de atividade/pessoa/viagem&#xa;- eventos de veiculo e link&#xa;- estatisticas SUMO-like (tripinfo/summary)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="570" y="590" width="730" height="130" as="geometry"/></mxCell>

        <mxCell id="pe1" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe2" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe3" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="p3" target="p6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe4" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="p4" target="p6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe5" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="p5" target="p6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe6" style="endArrow=block;html=1;dashed=1;" edge="1" parent="1" source="p1" target="p4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe7" style="endArrow=block;html=1;dashed=1;" edge="1" parent="1" source="p1" target="p5"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="mapping" name="07 - Mapeamento para Codigo">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="m0" value="Guia de Navegacao: Componentes x Arquivos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="630" y="20" width="980" height="60" as="geometry"/></mxCell>

        <mxCell id="m1" value="Core Managers&#xa;- core/actor/manager/SimulationManager.scala&#xa;- core/actor/manager/GlobalTimeManager.scala&#xa;- core/actor/manager/LocalTimeManagerBase.scala&#xa;- core/actor/manager/LocalDiscreteEventTimeManager.scala&#xa;- core/actor/manager/LoadDataManager.scala&#xa;- core/actor/manager/ReportManager.scala" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="90" y="130" width="620" height="220" as="geometry"/></mxCell>

        <mxCell id="m2" value="Base de Atores&#xa;- core/actor/BaseActor.scala&#xa;- core/actor/SimulationBaseActor.scala&#xa;- model/hybrid/actor/Movable.scala&#xa;- model/hybrid/actor/PrivateVehicle.scala" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="760" y="130" width="620" height="220" as="geometry"/></mxCell>

        <mxCell id="m3" value="Atores Hibridos de Mobilidade&#xa;- model/hybrid/actor/Car.scala&#xa;- model/hybrid/actor/Bus.scala&#xa;- model/hybrid/actor/Bicycle.scala&#xa;- model/hybrid/actor/Motorcycle.scala&#xa;- model/hybrid/actor/Person.scala&#xa;- model/hybrid/actor/Link.scala&#xa;- model/hybrid/actor/Node.scala&#xa;- model/hybrid/actor/TrafficSignal.scala" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1430" y="130" width="650" height="260" as="geometry"/></mxCell>

        <mxCell id="m4" value="Transporte Coletivo e Ferrovia&#xa;- model/hybrid/actor/BusStop.scala&#xa;- model/hybrid/actor/BusStation.scala&#xa;- model/hybrid/actor/Subway.scala&#xa;- model/hybrid/actor/SubwayStation.scala&#xa;- model/hybrid/actor/RailLink.scala" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="90" y="420" width="620" height="180" as="geometry"/></mxCell>

        <mxCell id="m5" value="Documentacao de apoio&#xa;- docs/HYBRID_IMPLEMENTATION_SUMMARY.md&#xa;- docs/HYBRID_QUICK_REFERENCE.md&#xa;- docs/HYBRID_ACTOR_CONFIGURATION.md&#xa;- docs/HYBRID_INPUT_MODEL.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="760" y="420" width="620" height="180" as="geometry"/></mxCell>

        <mxCell id="m6" value="Como usar este arquivo no draw.io&#xa;1) Abra docs/diagrams/htc_simulator_complete.drawio&#xa;2) Navegue pelas paginas no painel esquerdo&#xa;3) Duplique pagina para detalhar um fluxo especifico&#xa;4) Exporte PNG/SVG/PDF por pagina" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1430" y="450" width="650" height="150" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="actor-lifecycle-detailed" name="08 - Ciclo de Vida por Ator">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="l8_t" value="Ciclo de vida por ator (estado principal e transicoes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="720" y="20" width="1180" height="60" as="geometry"/></mxCell>

        <mxCell id="l8_core" value="Core / Infra" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="2500" height="60" as="geometry"/></mxCell>
        <mxCell id="l8_sim" value="SimulationManager&#xa;onStart -> PrepareSimulation&#xa;espera reporters+poolTM&#xa;startLoadData -> StartSimulation&#xa;StopSimulation -> forward stop + selfDestruct" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="470" height="150" as="geometry"/></mxCell>
        <mxCell id="l8_gtm" value="GlobalTimeManager&#xa;onStart -> cria pool localTM&#xa;startSimulation -> notify local managers&#xa;coleta LocalTimeReportEvent&#xa;calcula tick global -> broadcast UpdateGlobalTimeEvent&#xa;stop -> terminateSimulation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="560" y="190" width="470" height="150" as="geometry"/></mxCell>
        <mxCell id="l8_ltm" value="LocalTimeManagerBase / LocalDiscreteEventTM&#xa;onStart -> register no global&#xa;registerActor/scheduleEvent&#xa;processTick -> SpontaneousEvent para atores&#xa;finishEvent -> reportGlobalTimeManager&#xa;stop -> forceDestructActiveActors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1060" y="190" width="470" height="150" as="geometry"/></mxCell>
        <mxCell id="l8_load" value="LoadDataManager&#xa;LoadDataEvent -> cria loaders/creators&#xa;LoadNextEvent por classType&#xa;FinishLoadDataEvent por loader&#xa;all loaded -> notifica SimulationManager&#xa;StopSimulation -> destruct loaders" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1560" y="190" width="470" height="150" as="geometry"/></mxCell>
        <mxCell id="l8_rep" value="ReportManager&#xa;onStart -> cria pools de reporter&#xa;registerReporters no SimulationManager&#xa;onDestruct/Stop -> flush + destruct reporters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="2060" y="190" width="470" height="150" as="geometry"/></mxCell>

        <mxCell id="l8_hybrid" value="Atores de modelo hibrido" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="2500" height="60" as="geometry"/></mxCell>

        <mxCell id="l8_person" value="Person&#xa;ativo enquanto houver agenda&#xa;idle activity -> startNextTrip&#xa;modo privado: envia StartTripData&#xa;aguarda TripCompletedData&#xa;advanceActivity até schedule_complete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="390" height="150" as="geometry"/></mxCell>
        <mxCell id="l8_car" value="Car (PrivateVehicle)&#xa;Parked -> Start (StartTripData)&#xa;requestRoute -> Ready -> Moving&#xa;MESO: LinkInfoData enter/leave&#xa;MICRO: MicroEnter/MicroUpdate/MicroLeave&#xa;onFinishPrivateVehicle -> TripCompleted -> Parked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="480" y="470" width="390" height="150" as="geometry"/></mxCell>
        <mxCell id="l8_bus" value="Bus&#xa;Start -> Ready -> Moving&#xa;interacao com BusStop (load/unload)&#xa;RequestSignalState/SignalStateData&#xa;pode operar em MESO e MICRO&#xa;continua loop de rota" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="900" y="470" width="390" height="150" as="geometry"/></mxCell>
        <mxCell id="l8_bicycle" value="Bicycle (PrivateVehicle)&#xa;Parked -> StartTrip -> Moving&#xa;MESO/MICRO por modo do Link&#xa;requestSignal/leavingLink&#xa;onFinishPrivateVehicle -> TripCompleted -> Parked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1320" y="470" width="390" height="150" as="geometry"/></mxCell>
        <mxCell id="l8_motor" value="Motorcycle (PrivateVehicle)&#xa;Parked -> StartTrip -> Moving&#xa;MESO/MICRO com parametros agressivos&#xa;signal handling + leave flow&#xa;onFinishPrivateVehicle -> TripCompleted -> Parked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1740" y="470" width="390" height="150" as="geometry"/></mxCell>
        <mxCell id="l8_subway" value="Subway&#xa;Start -> Ready -> enter rail link&#xa;Moving -> Stopped (estacao)&#xa;load/unload passageiros&#xa;leave rail link -> Ready&#xa;loop em rota predefinida" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="2160" y="470" width="370" height="150" as="geometry"/></mxCell>

        <mxCell id="l8_link" value="Link&#xa;onInitialize: publica custo + init micro lanes (se MICRO)&#xa;EnterLinkData -> branch MESO/MICRO&#xa;MICRO: sub-ticks + MicroUpdateData&#xa;LeaveLinkData -> unregister + ack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="390" height="150" as="geometry"/></mxCell>
        <mxCell id="l8_node" value="Node&#xa;registra BusStop/SubwayStation&#xa;recebe RequestSignalStateData&#xa;responde SignalStateData&#xa;atualiza estado por TrafficSignalChangeStatusData" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="480" y="650" width="390" height="150" as="geometry"/></mxCell>
        <mxCell id="l8_signal" value="TrafficSignal&#xa;onInitialize agenda firstTick&#xa;por tick: handlePhaseTransition&#xa;calc Green/Red por fase&#xa;notifica Nodes com TrafficSignalChangeStatusData&#xa;reagenda proximo ciclo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="900" y="650" width="390" height="150" as="geometry"/></mxCell>
        <mxCell id="l8_bs" value="BusStop&#xa;onInitialize: RegisterBusStopData para Node&#xa;RegisterPassengerData -> fila por rota&#xa;BusRequestPassengerData -> BusLoadPassengerData" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1320" y="650" width="390" height="150" as="geometry"/></mxCell>
        <mxCell id="l8_bst" value="BusStation&#xa;Start -> calcula rotas no mapa&#xa;Ready/Working -> cria Bus periodicamente&#xa;mantem going/returning route&#xa;WorkingWithoutBus quando esvaziar fila" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1740" y="650" width="390" height="150" as="geometry"/></mxCell>
        <mxCell id="l8_sst" value="SubwayStation&#xa;onInitialize: register no Node&#xa;Start/Working -> cria Subway por linha/intervalo&#xa;atende pedido de embarque por linha&#xa;agenda proximo tick baseado em nextTick" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="2160" y="650" width="370" height="150" as="geometry"/></mxCell>

        <mxCell id="l8_rail" value="RailLink&#xa;valida tipo de veiculo (somente subway)&#xa;enter: registra + envia LinkInfoData&#xa;leave: unregister + confirma&#xa;rejeicao de tipo invalido = violacao de seguranca" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="830" width="390" height="150" as="geometry"/></mxCell>

        <mxCell id="l8_note" value="Nota: atores PrivateVehicle (Car/Bicycle/Motorcycle) compartilham o mesmo padrao de ativacao por Person e desativacao em Parked apos TripCompleted." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="480" y="850" width="2050" height="110" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="actor-messages-detailed" name="09 - Troca de Mensagens por Ator">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="m9_t" value="Catalogo de mensagens por ator (sender -> mensagem -> receiver)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="690" y="20" width="1220" height="60" as="geometry"/></mxCell>

        <mxCell id="m9_core_h" value="Core Managers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="2500" height="50" as="geometry"/></mxCell>
        <mxCell id="m9_core_1" value="SimulationManager -> PrepareSimulationEvent -> SimulationManager(selfProxy)&#xa;SimulationManager -> LoadDataEvent -> LoadDataManager&#xa;SimulationManager -> StartSimulationTimeEvent -> GlobalTimeManager&#xa;SimulationManager -> StopSimulationEvent -> Load/Report/Global" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="810" height="140" as="geometry"/></mxCell>
        <mxCell id="m9_core_2" value="GlobalTimeManager -> Broadcast(Start/Pause/Resume/UpdateGlobalTimeEvent) -> LocalTimeManagers&#xa;LocalTimeManager -> LocalTimeReportEvent -> GlobalTimeManager&#xa;GlobalTimeManager -> ScheduleEvent(route) -> pool local managers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="900" y="180" width="810" height="140" as="geometry"/></mxCell>
        <mxCell id="m9_core_3" value="LocalTimeManager -> SpontaneousEvent -> atores&#xa;Atores -> FinishEvent(+scheduleTick) -> LocalTimeManager&#xa;LocalTimeManager -> DestructEvent -> atores ativos (stop)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1740" y="180" width="780" height="140" as="geometry"/></mxCell>

        <mxCell id="m9_private_h" value="Person + Private Vehicles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="2500" height="50" as="geometry"/></mxCell>
        <mxCell id="m9_person" value="Person -> StartTripData -> Car/Bicycle/Motorcycle&#xa;Car/Bicycle/Motorcycle -> TripCompletedData -> Person&#xa;Person (walking) usa somente agendamento local (sem ator veiculo dedicado)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="430" width="810" height="120" as="geometry"/></mxCell>
        <mxCell id="m9_priv_common" value="PrivateVehicle trait&#xa;StartTripData: ativa veiculo, configura DriverAttributes&#xa;ParkVehicleData: encerra e volta Parked&#xa;TripCompletedData: enviado ao ownerPersonRef" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="900" y="430" width="810" height="120" as="geometry"/></mxCell>
        <mxCell id="m9_car_msgs" value="Car/Bicycle/Motorcycle -> EnterLinkData/LeaveLinkData -> Link&#xa;Node -> SignalStateData -> Car/Bicycle/Motorcycle&#xa;Link(MICRO) -> MicroEnterLinkData/MicroUpdateData/MicroLeaveLinkData -> Car/Bicycle/Motorcycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1740" y="430" width="780" height="120" as="geometry"/></mxCell>

        <mxCell id="m9_road_h" value="Rede Viaria (Link / Node / TrafficSignal)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="2500" height="50" as="geometry"/></mxCell>
        <mxCell id="m9_link_msgs" value="Link recebe: EnterLinkData, LeaveLinkData, MicroStepData, LaneChangeData, GlobalTickEvent&#xa;Link envia: LinkInfoData, MicroEnterLinkData, MicroUpdateData, MicroLeaveLinkData&#xa;Link publica: DynamicLinkCost -> DynamicWeightCache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="660" width="810" height="130" as="geometry"/></mxCell>
        <mxCell id="m9_node_msgs" value="BusStop -> RegisterBusStopData -> Node&#xa;SubwayStation -> RegisterSubwayStationData -> Node&#xa;Vehicle -> RequestSignalStateData -> Node&#xa;Node -> SignalStateData -> Vehicle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="900" y="660" width="810" height="130" as="geometry"/></mxCell>
        <mxCell id="m9_signal_msgs" value="TrafficSignal -> TrafficSignalChangeStatusData -> Node(s)&#xa;Node atualiza mapa de sinais e responde futuras consultas de veiculos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1740" y="660" width="780" height="130" as="geometry"/></mxCell>

        <mxCell id="m9_bus_h" value="Onibus / Pontos / Estacao de Onibus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="2500" height="50" as="geometry"/></mxCell>
        <mxCell id="m9_bus_1" value="BusStation -> cria ator Bus (ActorCreatorUtil)&#xa;Bus -> EnterLinkData/LeaveLinkData -> Link&#xa;Bus -> RequestSignalStateData -> Node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="900" width="810" height="120" as="geometry"/></mxCell>
        <mxCell id="m9_bus_2" value="BusStop -> BusLoadPassengerData -> Bus&#xa;Bus -> BusRequestPassengerData -> BusStop&#xa;Bus -> BusRequestUnloadPassengerData -> passageiros&#xa;passageiros -> BusUnloadPassengerData -> Bus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="900" y="900" width="810" height="120" as="geometry"/></mxCell>
        <mxCell id="m9_bus_3" value="BusStop registra chegada de passageiros (RegisterPassengerData)&#xa;e responde por rota/label" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1740" y="900" width="780" height="120" as="geometry"/></mxCell>

