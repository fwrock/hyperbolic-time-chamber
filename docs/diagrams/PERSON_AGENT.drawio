                            <mxPoint x="200" y="375"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="t2_drive" value="mode=car/bicycle/motorcycle&#xa;→ StartTripData, onFinish(None)" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="s_activity" target="s_driving" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="t2_pt" value="mode=bus/subway&#xa;→ RegisterPassenger, onFinish(None)" style="edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;" parent="1" source="s_activity" target="s_pt" edge="1">
