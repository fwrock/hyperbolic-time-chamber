                <mxCell id="s_idle" value="Idle&#xa;(aguardando startTick)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
