                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="t2_done" value="isScheduleComplete" style="edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s_activity" target="s_done" edge="1">
