                </mxCell>
                <mxCell id="s_driving" value="InVehicle&#xa;(TM cedido ao veículo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="360" y="350" width="180" height="50" as="geometry"/>
                </mxCell>
