                            <mxPoint x="170" y="480"/>
                            <mxPoint x="300" y="480"/>
                            <mxPoint x="300" y="265"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="tdrive_back" value="TripCompletedData&#xa;advanceActivity()" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="s_driving" target="s_activity" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
