                    </mxGeometry>
                </mxCell>
                <mxCell id="twalk_back" value="arrivalTick reached&#xa;advanceActivity()" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="s_walking" target="s_activity" edge="1">
