                <mxCell id="s_activity" value="InActivity&#xa;(dorme até endTime)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="1" vertex="1">
