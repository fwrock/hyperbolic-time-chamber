                            <mxPoint x="620" y="545"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="t2_walk" value="mode=walk&#xa;onFinish(Some(arrivalTick))" style="edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;" parent="1" source="s_activity" target="s_walking" edge="1">
