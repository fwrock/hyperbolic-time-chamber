{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "htc:actor/TrafficSignal",
  "title": "Sem\u00e1foro",
  "description": "Controle semaf\u00f3rico de um ou mais n\u00f3s.",
  "x-htc-class": "hybrid.actor.TrafficSignal",
  "x-htc-version": 1,
  "x-htc-filterable": false,
  "x-htc-dependencies": [
    {
      "name": "*",
      "class": "Node",
      "required": false,
      "relation": "reference",
      "note": "uma entrada por n\u00f3 controlado, com a chave igual ao id do n\u00f3"
    }
  ],
  "type": "object",
  "required": [
    "id",
    "typeActor",
    "data"
  ],
  "properties": {
    "id": {
      "type": "integer"
    },
    "typeActor": {
      "const": "hybrid.actor.TrafficSignal"
    },
    "data": {
      "type": "object",
      "required": [
        "dataType",
        "content"
      ],
      "properties": {
        "dataType": {
          "const": "model.hybrid.entity.state.TrafficSignalState"
        },
        "content": {
          "type": "object",
          "required": [
            "startTick"
          ],
          "properties": {
            "startTick": {
              "type": "integer",
              "x-htc-label": "Tick inicial",
              "x-htc-group": "Tempo",
              "x-htc-unit": "ticks",
              "minimum": 0,
              "x-htc-help": "Quando o ator entra na simula\u00e7\u00e3o."
            },
            "scheduleOnTimeManager": {
              "type": "boolean",
              "x-htc-label": "Agendar no gerenciador de tempo",
              "x-htc-group": "Tempo"
            },
            "cycleDuration": {
              "type": "integer",
              "x-htc-label": "Dura\u00e7\u00e3o do ciclo",
              "x-htc-group": "Ciclo",
              "x-htc-unit": "ticks",
              "minimum": 1
            },
            "offset": {
              "type": "integer",
              "x-htc-label": "Defasagem",
              "x-htc-group": "Ciclo",
              "x-htc-unit": "ticks",
              "minimum": 0
            },
            "nodes": {
              "type": "array",
              "x-htc-label": "N\u00f3s controlados",
              "x-htc-group": "Rede",
              "items": {
                "type": "integer",
                "x-htc-ref": "Node"
              },
              "x-htc-widget": "ids",
              "x-htc-ref": "Node"
            },
            "phases": {
              "type": "array",
              "x-htc-label": "Fases",
              "x-htc-group": "Ciclo",
              "x-htc-widget": "table",
              "x-htc-help": "Uma linha por aproxima\u00e7\u00e3o (origin = via de entrada) com o in\u00edcio e a dura\u00e7\u00e3o do verde dentro do ciclo.",
              "items": {
                "type": "object",
                "required": [
                  "origin",
                  "greenStart",
                  "greenDuration"
                ],
                "properties": {
                  "origin": {
                    "type": "integer",
                    "x-htc-label": "Via de entrada",
                    "x-htc-ref": "Link"
                  },
                  "greenStart": {
                    "type": "integer",
                    "minimum": 0,
                    "x-htc-label": "In\u00edcio do verde",
                    "x-htc-unit": "ticks"
                  },
                  "greenDuration": {
                    "type": "integer",
                    "minimum": 0,
                    "x-htc-label": "Dura\u00e7\u00e3o do verde",
                    "x-htc-unit": "ticks"
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "Red",
                      "Yellow",
                      "Green",
                      "Off"
                    ],
                    "x-htc-label": "Estado inicial"
                  }
                }
              }
            },
            "signalStates": {
              "type": "object",
              "x-htc-label": "Estados dos sinais",
              "x-htc-group": "Registros",
              "x-htc-widget": "json",
              "x-htc-editable": false
            },
            "program": {
              "type": "object",
              "properties": {
                "control": {
                  "type": "string",
                  "enum": [
                    "Fixed",
                    "GapActuated"
                  ],
                  "default": "Fixed"
                },
                "stages": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "durationSeconds": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "green": {
                        "type": "array",
                        "items": {
                          "type": "integer"
                        }
                      },
                      "yellow": {
                        "type": "array",
                        "items": {
                          "type": "integer"
                        }
                      },
                      "minDurationSeconds": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "maxDurationSeconds": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "detectors": {
                        "type": "array",
                        "items": {
                          "type": "integer"
                        }
                      },
                      "off": {
                        "type": "array",
                        "items": {
                          "type": "integer"
                        }
                      }
                    },
                    "required": [
                      "durationSeconds"
                    ]
                  }
                },
                "movements": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "origin": {
                        "type": "integer"
                      },
                      "nodeId": {
                        "type": "integer"
                      },
                      "incomingLinkId": {
                        "type": "integer"
                      },
                      "outgoingLinkId": {
                        "type": "integer"
                      },
                      "laneIds": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    },
                    "required": [
                      "origin",
                      "nodeId",
                      "incomingLinkId",
                      "outgoingLinkId"
                    ]
                  }
                },
                "maxGapSeconds": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 3
                },
                "extensionSeconds": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 2
                },
                "checkIntervalSeconds": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 1
                },
                "initialStage": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 0
                },
                "initialElapsedSeconds": {
                  "type": "number",
                  "minimum": 0,
                  "default": 0
                },
                "reportMovementChanges": {
                  "type": "boolean",
                  "default": false,
                  "description": "Emit individual movement-aspect reports in addition to the ordered-stage trace."
                }
              },
              "required": [
                "stages",
                "movements"
              ]
            }
          },
          "anyOf": [
            {
              "required": [
                "program"
              ]
            },
            {
              "required": [
                "cycleDuration",
                "offset",
                "nodes",
                "phases"
              ]
            }
          ]
        }
      }
    }
  }
}
