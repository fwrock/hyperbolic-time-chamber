{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "htc:actor/Car",
  "title": "Carro",
  "description": "Veículo privado; parte da pessoa dona (owner).",
  "x-htc-class": "hybrid.actor.Car",
  "x-htc-version": 1,
  "x-htc-filterable": true,
  "x-htc-dependencies": [
    {
      "name": "from_node",
      "class": "Node",
      "required": true,
      "relation": "reference"
    },
    {
      "name": "to_node",
      "class": "Node",
      "required": true,
      "relation": "reference"
    },
    {
      "name": "owner",
      "class": "Person",
      "required": false,
      "relation": "part_of"
    }
  ],
  "type": "object",
  "required": [
    "id",
    "typeActor",
    "data"
  ],
  "properties": {
    "id": {
      "type": "integer"
    },
    "typeActor": {
      "const": "hybrid.actor.Car"
    },
    "data": {
      "type": "object",
      "required": [
        "dataType",
        "content"
      ],
      "properties": {
        "dataType": {
          "const": "model.hybrid.entity.state.CarState"
        },
        "content": {
          "type": "object",
          "required": [
            "startTick",
            "origin",
            "actorType",
            "size"
          ],
          "properties": {
            "startTick": {
              "type": "integer",
              "x-htc-label": "Tick inicial",
              "x-htc-group": "Tempo",
              "x-htc-unit": "ticks",
              "minimum": 0,
              "x-htc-help": "Quando o ator entra na simulação."
            },
            "scheduleOnTimeManager": {
              "type": "boolean",
              "x-htc-label": "Agendar no gerenciador de tempo",
              "x-htc-group": "Tempo"
            },
            "origin": {
              "type": "integer",
              "x-htc-label": "Nó de origem",
              "x-htc-group": "Viagem",
              "x-htc-ref": "Node"
            },
            "destination": {
              "type": "integer",
              "x-htc-label": "Nó de destino",
              "x-htc-group": "Viagem",
              "x-htc-ref": "Node"
            },
            "actorType": {
              "type": "string",
              "x-htc-label": "Tipo",
              "x-htc-group": "Veículo",
              "enum": [
                "Car",
                "Bicycle",
                "Motorcycle",
                "Bus"
              ]
            },
            "size": {
              "type": "number",
              "x-htc-label": "Comprimento",
              "x-htc-group": "Veículo",
              "x-htc-unit": "m",
              "exclusiveMinimum": 0
            },
            "distance": {
              "type": "number",
              "x-htc-label": "Distância percorrida",
              "x-htc-group": "Viagem",
              "x-htc-unit": "m",
              "minimum": 0
            },
            "currentSimulationMode": {
              "type": "string",
              "x-htc-label": "Modo de simulação",
              "x-htc-group": "Simulação",
              "enum": [
                "MESO",
                "MICRO"
              ]
            },
            "precomputedRoute": {
              "type": [
                "array",
                "null"
              ],
              "x-htc-label": "Rota pré-calculada",
              "x-htc-group": "Viagem",
              "x-htc-widget": "json"
            },
            "microState": {
              "type": [
                "object",
                "null"
              ],
              "x-htc-label": "Estado micro",
              "x-htc-group": "Registros",
              "x-htc-widget": "json",
              "x-htc-editable": false
            },
            "microAcceleration": {
              "type": [
                "number",
                "null"
              ],
              "description": "Optional MICRO acceleration bound; otherwise use the actor-type default.",
              "exclusiveMinimum": 0,
              "x-htc-unit": "m/s²"
            },
            "microDeceleration": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0,
              "x-htc-unit": "m/s²"
            },
            "microDepartPosition": {
              "type": "number",
              "minimum": 0,
              "default": 0,
              "x-htc-unit": "m"
            },
            "microArrivalPosition": {
              "type": [
                "number",
                "null"
              ],
              "description": "Position on the final road; null traverses the full road.",
              "minimum": 0,
              "x-htc-unit": "m"
            },
            "microMinGap": {
              "type": [
                "number",
                "null"
              ],
              "description": "Minimum bumper gap for MICRO following; null keeps the native 2 m default.",
              "x-htc-unit": "m",
              "minimum": 0
            },
            "microReactionTime": {
              "type": [
                "number",
                "null"
              ],
              "description": "MICRO following reaction time; null keeps the native 1 s default.",
              "x-htc-unit": "s",
              "exclusiveMinimum": 0
            },
            "microMaxSpeed": {
              "type": [
                "number",
                "null"
              ],
              "description": "Vehicle speed cap combined with each road limit; null uses the road limit.",
              "x-htc-unit": "m/s",
              "exclusiveMinimum": 0
            },
            "microSpeedFactor": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 1,
              "description": "Driver multiplier on road and desired speed limits; the vehicle maximum speed remains an independent cap."
            },
            "microDesiredMaxSpeed": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0,
              "x-htc-unit": "m/s",
              "description": "Optional desired speed cap before applying microSpeedFactor; null uses the road limit."
            },
            "microSigma": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0,
              "description": "Krauss-style driver imperfection, drawn every MICRO physics step. Zero preserves deterministic following."
            },
            "microRandomSeed": {
              "type": "integer",
              "default": 0,
              "description": "Checkpointed seed for vehicle/physical-step random draws; independent of message order and JVM placement."
            },
            "microLc2013": {
              "type": "object",
              "description": "Per-vehicle parameters for the native LC2013-style supported subset; select Lc2013 on the Link.",
              "additionalProperties": false,
              "properties": {
                "strategic": {
                  "type": "number",
                  "minimum": 0,
                  "default": 1
                },
                "cooperative": {
                  "type": "number",
                  "minimum": 0,
                  "default": 1
                },
                "speedGain": {
                  "type": "number",
                  "minimum": 0,
                  "default": 1
                },
                "keepRight": {
                  "type": "number",
                  "minimum": 0,
                  "default": 1
                },
                "lookaheadLeft": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 2
                },
                "speedGainRight": {
                  "type": "number",
                  "minimum": 0,
                  "default": 0.1
                },
                "speedGainRemainTimeSeconds": {
                  "type": "number",
                  "minimum": 0,
                  "default": 20
                },
                "keepRightTimeSeconds": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 5
                }
              }
            },
            "mesoOriginLinkId": {
              "type": "integer",
              "description": "Optional initial source link whose end is a zero-distance, flow-limited MESO origin boundary."
            }
          }
        }
      }
    }
  }
}
