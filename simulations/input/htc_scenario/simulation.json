{
  "id": "htc_simulation_sumo",
  "name": "HTC-Simulator: cenario_1000_viagens",
  "description": "Simulates a smart mobility scenario with a map and car trips generated from MATSim data",
  "randomSeed": 42,
  "startRealTime": "2025-01-27T00:00:00.000",
  "extendSimulationIfPendingEventsAfterEnd": true,
  "timeUnit": "seconds",
  "timeStep": 1,
  "duration": 86400,
  "startTick": 0,
  "actorsDataSources": [
    {
      "id": "htcrid:node;1",
      "classType": "hybrid.actor.Node",
      "creationType": "LoadBalancedDistributed",
      "dataSource": {
        "sourceType": "json",
        "info": {
          "path": "/app/hyperbolic-time-chamber/simulations/input/htc_scenario/data/nodes_1.json"
        }
      }
    },
    {
      "id": "htcrid:link;1",
      "classType": "hybrid.actor.Link",
      "creationType": "LoadBalancedDistributed",
      "dataSource": {
        "sourceType": "json",
        "info": {
          "path": "/app/hyperbolic-time-chamber/simulations/input/htc_scenario/data/links_1.json"
        }
      }
    },
    {
      "id": "htcrid:link;2",
      "classType": "hybrid.actor.Link",
      "creationType": "LoadBalancedDistributed",
      "dataSource": {
        "sourceType": "json",
        "info": {
          "path": "/app/hyperbolic-time-chamber/simulations/input/htc_scenario/data/links_2.json"
        }
      }
    },
    {
      "id": "htcrid:car;1",
      "classType": "hybrid.actor.Car",
      "creationType": "LoadBalancedDistributed",
      "dataSource": {
        "sourceType": "json",
        "info": {
          "path": "/app/hyperbolic-time-chamber/simulations/input/htc_scenario/data/cars_1.json"
        }
      }
    }
  ],
  "cityMapFile": "/app/hyperbolic-time-chamber/simulations/input/htc_scenario/data/city_map.json"
}